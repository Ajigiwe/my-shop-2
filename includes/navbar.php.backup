<?php
/**
 * Navbar include
 * - Uses $base (computed in header.php) to make links work from root, /admin, and /user
 * - Shows dynamic category dropdown and cart count for the logged-in user
 * - Exposes admin link when current user has role 'admin'
 */

// Define $base variable if not already defined (fallback for pages that don't use header.php)
if (!isset($base)) {
    $script = $_SERVER['PHP_SELF'] ?? '';
    $inAdmin = strpos($script, '/admin/') !== false;
    $inUser  = strpos($script, '/user/') !== false;
    $inLegal = strpos($script, '/legal/') !== false;
    $base = ($inAdmin || $inUser || $inLegal) ? '../' : '';
}

// Define $site_name if not already defined
if (!isset($site_name)) {
    $site_name = 'ASO Online Market';
}
?>

<?php
// Start session if not already started
if (session_status() == PHP_SESSION_NONE) {
    session_start();
}

// Include database connection
require_once 'db.php';

// Get cart count for logged-in users
$cart_count = 0;
if (isset($_SESSION['user_id'])) {
    try {
        $stmt = $pdo->prepare("SELECT SUM(quantity) as total FROM cart WHERE user_id = ?");
        $stmt->execute([$_SESSION['user_id']]);
        $result = $stmt->fetch();
        $cart_count = $result['total'] ?? 0;
    } catch(PDOException $e) {
        // Handle error silently
    }
}

// Get all categories for dropdown (use a distinct variable name to avoid collisions)
$nav_categories = [];
try {
    $stmt = $pdo->query("SELECT * FROM categories ORDER BY category_name");
    $nav_categories = $stmt->fetchAll();
} catch(PDOException $e) {
    // Handle error silently
}
?>

<nav class="navbar navbar-expand-lg navbar-light sticky-top">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand" href="<?php echo $base; ?>index.php">
            <i class="fas fa-store me-2"></i><?php echo isset($site_name) ? htmlspecialchars($site_name) : 'ASO Online Market'; ?>
        </a>
        
        <!-- Mobile toggle button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Navigation menu (left: primary links + category dropdown; right: search and user/cart) -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- Left side menu -->
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="<?php echo $base; ?>index.php">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<?php echo $base; ?>shop.php">Shop</a>
                </li>
                
                <!-- Categories dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" onclick="toggleDropdown('categoriesDropdown'); return false;">
                        Categories
                    </a>
                    <ul class="dropdown-menu" id="categoriesDropdown">
                        <?php foreach ($nav_categories as $category): ?>
                            <li>
                                <a class="dropdown-item" href="<?php echo $base; ?>category.php?id=<?php echo $category['category_id']; ?>">
                                    <?php echo htmlspecialchars($category['category_name']); ?>
                                </a>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="<?php echo $base; ?>about.php">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="<?php echo $base; ?>contact.php">Contact</a>
                </li>
            </ul>
            
            <!-- Right side menu -->
            <ul class="navbar-nav">
                <?php if (isset($_SESSION['user_id'])): ?>
                    <!-- User is logged in -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" onclick="toggleDropdown('userDropdown'); return false;">
                            <i class="fas fa-user me-1"></i><?php echo htmlspecialchars($_SESSION['user_name']); ?>
                        </a>
                        <ul class="dropdown-menu" id="userDropdown">
                            <li><a class="dropdown-item" href="<?php echo $base; ?>user/profile.php">Profile</a></li>
                            <li><a class="dropdown-item" href="<?php echo $base; ?>user/orders.php">My Orders</a></li>
                            <?php if (isset($_SESSION['user_role']) && $_SESSION['user_role'] === 'admin'): ?>
                                <!-- Admin-only quick link -->
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="<?php echo $base; ?>admin/dashboard.php">Admin Panel</a></li>
                            <?php endif; ?>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="<?php echo $base; ?>logout.php">Logout</a></li>
                        </ul>
                    </li>
                    
                    <!-- Cart with badge showing total quantity for current user -->
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="<?php echo $base; ?>cart.php">
                            <i class="fas fa-shopping-cart"></i>
                            <?php if ($cart_count > 0): ?>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    <?php echo $cart_count; ?>
                                </span>
                            <?php endif; ?>
                        </a>
                    </li>
                <?php else: ?>
                    <!-- User is not logged in -->
                    <li class="nav-item">
                        <a class="nav-link" href="<?php echo $base; ?>login.php">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="<?php echo $base; ?>register.php">Register</a>
                    </li>
                <?php endif; ?>
            </ul>
        </div>
    </div>
</nav>
