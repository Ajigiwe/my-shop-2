# Production .htaccess for asoonlinemarket.com
# Enforce HTTPS, hide .php extensions, protect sensitive files, and add security headers

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Redirect HTTP to HTTPS only for production domain
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^(www\.)?asoonlinemarket\.com$ [NC]
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Redirect requests with .php in URL to extensionless URL only on production host
	RewriteCond %{HTTP_HOST} ^(www\.)?asoonlinemarket\.com$ [NC]
	RewriteCond %{THE_REQUEST} \.php [NC]
	RewriteRule ^(.*)\.php$ $1 [R=301,L]

	# If a request doesn't map to a file or directory but the same name + .php exists, serve that
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteRule ^(.*)$ $1.php [L]

</IfModule>

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(?:\.env|composer\.json|composer\.lock|README\.md|full_database_export\.sql|master_setup\.sql)$">
	Require all denied
</FilesMatch>

# Deny direct access to logs, migrations, sql, and data folders using rewrite (works in .htaccess)
<IfModule mod_rewrite.c>
	RewriteRule ^(logs|migrations|sql|data)(/|$) - [F,L]
</IfModule>

# Protect includes folder from direct web access
<IfModule mod_rewrite.c>
	RewriteRule ^includes/ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-XSS-Protection "1; mode=block"
	Header always set Referrer-Policy "no-referrer-when-downgrade"
	Header always set Permissions-Policy "geolocation=(), microphone=()"
	Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# Caching for static assets (images, fonts, css, js)
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpg "access plus 1 month"
	ExpiresByType image/jpeg "access plus 1 month"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/gif "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType text/css "access plus 1 month"
	ExpiresByType text/javascript "access plus 1 month"
	ExpiresByType application/javascript "access plus 1 month"
	ExpiresByType application/font-woff2 "access plus 1 month"
	ExpiresByType application/font-woff "access plus 1 month"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
	ExpiresByType font/otf "access plus 1 month"
</IfModule>

# Reduce info leakage
ServerSignature Off

# Prevent MIME sniffing
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options nosniff
</IfModule>

# Fallback - keep index.php as the front controller if used
DirectoryIndex index.php index.html
