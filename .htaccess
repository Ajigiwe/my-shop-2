# Safe Production .htaccess for asoonlinemarket.com

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Redirect HTTP to HTTPS for production domain
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^(www\.)?asoonlinemarket\.com$ [NC]
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Hide .php extensions safely (only for direct requests, excluding index.php)
	RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
	RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
	RewriteRule ^ /%1 [R=301,L]

	# Resolve extensionless URLs to .php files
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteRule ^(.*)$ $1.php [L]

	# Protect sensitive directories
	RewriteRule ^(logs|migrations|sql|data|includes)(/|$) - [F,L]
</IfModule>

# Protect sensitive files
<FilesMatch "^(?:\.env|composer\.json|composer\.lock|README\.md|.*\.sql)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-XSS-Protection "1; mode=block"
	Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
