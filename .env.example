# ========================================================
# FreshTech Storefront Configuration
# Rename this file to .env on your hosting server
# ========================================================

# 1. Database Configuration
# ProFreeHost typically uses "sqlXXX.epizy.com" or similar for DB_HOST
DB_HOST=localhost
DB_NAME=your_profreehost_db_name
DB_USER=your_profreehost_db_user
DB_PASS=your_profreehost_db_password

# 2. Site Configuration
# Set this to your ProFreeHost domain (e.g., http://yourstore.epizy.com/)
# Make sure to include the trailing slash!
SITE_URL=http://localhost/my-shop-2-main/

# 3. Third-Party Integrations (Optional)
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
